@page "/reset-password"
@using DigitalLoppemarkedLib.Service
@using System.ComponentModel.DataAnnotations
@inject UserService UserService
@inject NavigationManager NavManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Nulstil adgangskode</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Nulstil adgangskode</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="HandleReset" FormName="resetPasswordForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Ny adgangskode</label>
                            <InputText @bind-Value="model.NewPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.NewPassword)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gentag ny adgangskode</label>
                            <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.ConfirmPassword)" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <button type="submit" class="btn btn-primary w-100">Nulstil adgangskode</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] [SupplyParameterFromQuery]
    public string? token { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel model { get; set; } = new();
    private string? errorMessage;

    private async Task HandleReset()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(token))
        {
            errorMessage = "Intet nulstillingslink fundet.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "De nye adgangskoder skal være identiske.";
            return;
        }

        var result = await UserService.ResetPasswordAsync(token, model.NewPassword);

        if (result.Success)
        {
            NavManager.NavigateTo("/login", true);
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    public class ResetPasswordModel
    {
        [Required(ErrorMessage = "Ny adgangskode er påkrævet")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Gentag ny adgangskode er påkrævet")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
