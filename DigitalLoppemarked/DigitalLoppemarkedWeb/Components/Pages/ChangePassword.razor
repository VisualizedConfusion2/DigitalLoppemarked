@page "/change-password"
@using DigitalLoppemarkedLib.Service
@using DigitalLoppemarkedLib.Data.Repositories
@using System.ComponentModel.DataAnnotations
@inject UserService UserService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavManager

<PageTitle>Skift adgangskode</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Skift adgangskode</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="HandleChangePassword" FormName="changePasswordForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Nuværende adgangskode</label>
                            <InputText @bind-Value="model.CurrentPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.CurrentPassword)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ny adgangskode</label>
                            <InputText @bind-Value="model.NewPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.NewPassword)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gentag ny adgangskode</label>
                            <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.ConfirmPassword)" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <button type="submit" class="btn btn-primary w-100">Opdater adgangskode</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ChangePasswordModel model { get; set; } = new();
    private string? errorMessage;

    private async Task HandleChangePassword()
    {
        errorMessage = null;
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        if (userId == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "De nye adgangskoder skal være identiske.";
            return;
        }

        var result = await UserService.ChangePasswordAsync(userId.Value, model.CurrentPassword, model.NewPassword);

        if (result.Success)
        {
            // We must update the security stamp in the current session immediately
            // so the middleware doesn't log us out.
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext != null)
            {
                var userRepo = httpContext.RequestServices.GetRequiredService<IUserRepository>();
                var user = await userRepo.GetByIdAsync(userId.Value, default);
                if (user != null)
                {
                    httpContext.Session.SetString("SecurityStamp", user.SecurityStamp);
                }
            }

            NavManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "Nuværende adgangskode er påkrævet")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ny adgangskode er påkrævet")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Gentag ny adgangskode er påkrævet")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
