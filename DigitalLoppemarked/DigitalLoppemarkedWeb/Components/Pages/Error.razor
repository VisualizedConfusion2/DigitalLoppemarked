@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Components

<PageTitle>Something went wrong</PageTitle>

<div class="container mt-5 text-center">
    <h1 class="display-6 text-danger">Something went wrong</h1>
    <p class="text-muted">
        An unexpected error occurred while processing your request. Please try again later.
    </p>

    @if (ShowRequestId)
    {
        <p class="small text-muted">
            If you contact support, please provide this reference:
            <code>@RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary mt-2">Back to products</a>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Correlation ID only — never expose exception details, stack traces or paths.
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
