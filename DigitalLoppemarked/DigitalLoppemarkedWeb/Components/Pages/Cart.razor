@page "/cart"
@rendermode InteractiveServer
@implements IDisposable
@using DigitalLoppemarkedLib.Models
@using DigitalLoppemarkedLib.Service
@inject CartService CartService
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <h2 class="mb-4">Your Cart</h2>

    @if (!CartService.Items.Any())
    {
        <div class="alert alert-info">
            Your cart is empty. <a href="/">Go back and add some products.</a>
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th style="width: 160px;">Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartService.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                     style="width: 48px; height: 48px; object-fit: cover;" class="rounded" />
                                <span>@item.Product.Name</span>
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <button class="btn btn-outline-secondary" type="button"
                                        @onclick="() => ChangeQuantity(item.Product, -1)">
                                    -
                                </button>
                                <input type="number" class="form-control text-center" value="@item.Quantity"
                                       @onchange="e => SetQuantity(item.Product, e.Value)" min="1" />
                                <button class="btn btn-outline-secondary" type="button"
                                        @onclick="() => ChangeQuantity(item.Product, 1)">
                                    +
                                </button>
                            </div>
                        </td>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>@item.Subtotal.ToString("C")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => CartService.RemoveFromCart(item.Product.Id)">
                                <i class="bi bi-trash"></i> Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <button class="btn btn-outline-secondary" @onclick="ClearCart">
                <i class="bi bi-x-circle"></i> Clear Cart
            </button>

            <div class="text-end">
                <h4>Total: @CartService.Total.ToString("C")</h4>
                <button class="btn btn-success" @onclick="Checkout">
                    <i class="bi bi-bag-check"></i> Proceed to Checkout
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        // Re-render whenever the cart changes (e.g. added from another page)
        CartService.OnChange += StateHasChanged;
    }

    private void ChangeQuantity(Product product, int delta)
    {
        var item = CartService.Items.FirstOrDefault(i => i.Product.Id == product.Id);
        if (item is null) return;

        var newQty = item.Quantity + delta;
        if (newQty <= 0)
        {
            CartService.RemoveFromCart(product.Id);
        }
        else
        {
            // AddToCart increments existing quantity, so we add the delta directly
            CartService.AddToCart(product, delta);
        }
    }

    private void SetQuantity(Product product, object? value)
    {
        if (value is null || !int.TryParse(value.ToString(), out var newQty)) return;

        var item = CartService.Items.FirstOrDefault(i => i.Product.Id == product.Id);
        if (item is null) return;

        var delta = newQty - item.Quantity;
        if (newQty <= 0)
        {
            CartService.RemoveFromCart(product.Id);
        }
        else if (delta != 0)
        {
            CartService.AddToCart(product, delta);
        }
    }

    private void ClearCart() => CartService.Clear();

    private void Checkout() => NavigationManager.NavigateTo("/checkout");

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
