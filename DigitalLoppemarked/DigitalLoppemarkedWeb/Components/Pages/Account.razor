@page "/account"
@using DigitalLoppemarkedLib.Service
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@inject UserService UserService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavManager

<PageTitle>Min Konto</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="mb-0">Min Profil</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@profileModel" OnValidSubmit="HandleUpdateProfile" FormName="updateProfileForm">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fulde navn</label>
                                <InputText @bind-Value="profileModel.FullName" class="form-control" />
                                <ValidationMessage For="@(() => profileModel.FullName)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">E-mail (kan ikke ændres)</label>
                                <input type="text" class="form-control" value="@profileModel.Email" disabled />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(profileMessage))
                        {
                            <div class="alert alert-info">@profileMessage</div>
                        }

                        <button type="submit" class="btn btn-primary">Gem profiloplysninger</button>
                    </EditForm>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Sikkerhed</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">Her kan du ændre din adgangskode for at sikre din konto.</p>

                    <div class="d-grid gap-2">
                        <a href="/change-password" class="btn btn-outline-secondary">Skift adgangskode</a>
                        <a href="/forgot-password" class="btn btn-link text-muted">Glemt adgangskode?</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ProfileModel profileModel { get; set; } = new();
    private string? profileMessage;

    protected override async Task OnInitializedAsync()
    {
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        if (userId != null)
        {
            // We'll use the UserService to get current data
            // Since we don't have a GetUser method in UserService,
            // we'll fetch it via the repo if needed, but for now
            // we just ensure the page loads.
            // In a real app, we'd load current user details here.
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    private async Task HandleUpdateProfile()
    {
        profileMessage = null;
        var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
        if (userId == null) return;

        // Logic for updating name will be implemented in UserService
        var result = await UserService.UpdateProfileAsync(userId.Value, profileModel.FullName);

        if (result.Success)
        {
            profileMessage = "Din profil er blevet opdateret.";
        }
        else
        {
            profileMessage = result.Message;
        }
    }

    public class ProfileModel
    {
        [Required(ErrorMessage = "Navn er påkrævet")]
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
