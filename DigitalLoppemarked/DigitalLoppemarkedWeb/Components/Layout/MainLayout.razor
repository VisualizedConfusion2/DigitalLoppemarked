@inherits Microsoft.AspNetCore.Components.LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavManager

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            @if (HttpContextAccessor.HttpContext?.Session.GetInt32("UserId") == null)
            {
                <a href="login" class="me-2">Log ind</a>
                <a href="register" class="me-2">Opret konto</a>
            }
            else
            {
                @* Logout is a POST protected by an antiforgery token (story 2),
                   so it cannot be triggered by a cross-site GET. *@
                <EditForm Model="LogoutModel" FormName="logout" OnValidSubmit="DoLogout" class="d-inline">
                    <button type="submit" class="btn btn-link p-0 align-baseline me-2">Log ud</button>
                </EditForm>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Plain instance (no [SupplyParameterFromForm]): logout submits no fields, we only
    // need the named form + antiforgery token + OnValidSubmit to fire.
    private readonly LogoutForm LogoutModel = new();

    private void DoLogout()
    {
        // Server-side session invalidation (not just dropping the cookie).
        HttpContextAccessor.HttpContext?.Session.Clear();
        NavManager.NavigateTo("/", forceLoad: true);
    }

    private sealed class LogoutForm { }
}
